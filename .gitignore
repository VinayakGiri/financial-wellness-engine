# Virtual environment
venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# Log files
*.log
outputs/*.log

# Secrets — never commit
.env
.streamlit/credentials.toml

# Raw data (unprocessed inputs)
data/raw/

# IDE
.vscode/
.idea/

# macOS
.DS_Store

# Jupyter checkpoints
.ipynb_checkpoints/

# Keep all outputs, charts, CSVs, JSONs, notebooks
!outputs/
!outputs/**
!data/*.csv
!models/*.json
!notebooks/
