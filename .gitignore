# Virtual environment
venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# Secrets — never commit
.env

# Large binary model files (use Git LFS for these if needed)
*.pkl
models/*.pkl

# Raw data (unprocessed inputs)
data/raw/

# IDE
.vscode/
.idea/

# macOS
.DS_Store

# Jupyter checkpoints
.ipynb_checkpoints/

# Keep all outputs, charts, CSVs, JSONs, notebooks
!outputs/
!outputs/**
!data/*.csv
!models/*.json
!notebooks/
